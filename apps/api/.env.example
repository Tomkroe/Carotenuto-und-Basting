DATABASE_URL="postgresql://makler:makler@localhost:5432/maklerprogram?schema=public"
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
PORT=3001
WEB_ORIGIN="http://localhost:3000"

# S3-kompatibler Objektspeicher für Dokumente (lokal: MinIO aus docker-compose).
# In Produktion auf die eigene Storage-Hardware im Büro umstellen (S3_ENDPOINT).
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="maklerprogram-dokumente"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_FORCE_PATH_STYLE="true"
