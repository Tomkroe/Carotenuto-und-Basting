generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Mandant / User ──────────────────────────────────────────────

enum UserRole {
  OWNER
  VERWALTER
}

model Mandant {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users                  User[]
  objekte                Objekt[]
  kontakte               Kontakt[]
  vorgaenge              Vorgang[]
  labels                 Label[]
  zaehler                Zaehler[]
  dokumente              Dokument[]
  dokumentKategorien     DokumentKategorie[]
  vorgangVorlagen        VorgangVorlage[]
  workflows              Workflow[]
  belege                 Beleg[]
}

model Workflow {
  id        String   @id @default(cuid())
  label     String
  prompt    String
  createdAt DateTime @default(now())

  mandantId String
  mandant   Mandant @relation(fields: [mandantId], references: [id], onDelete: Cascade)

  @@index([mandantId])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(VERWALTER)
  createdAt    DateTime @default(now())

  mandantId String
  mandant   Mandant @relation(fields: [mandantId], references: [id], onDelete: Cascade)

  verantwortlicheVorgaenge Vorgang[]    @relation("VorgangVerantwortlicher")
  kommentare               Kommentar[]
  dokumente                Dokument[]
  verlaufEintraege         VorgangVerlauf[]

  @@index([mandantId])
}

// ── Objekte / Einheiten ─────────────────────────────────────────

enum ObjektTyp {
  WOHN_GESCHAEFTSHAUS
  EINHEITEN
  EINFAMILIENHAUS
  WEG
}

model Objekt {
  id        String    @id @default(cuid())
  typ       ObjektTyp
  name      String
  strasse   String
  hausnummer String
  plz       String
  ort       String
  land      String   @default("DE")
  kaltmiete Decimal? @db.Decimal(10, 2)
  flaeche   Decimal? @db.Decimal(10, 2)
  hausgeld  Decimal? @db.Decimal(10, 2)
  eigenschaften Json  @default("{}")
  titelbildKey String?
  abrechnungszeitraumStart String? @default("01-01")
  abrechnungszeitraumEnde  String? @default("31-12")
  bankKontoinhaber String?
  bankIban         String?
  bankBic          String?
  createdAt DateTime @default(now())

  mandantId String
  mandant   Mandant @relation(fields: [mandantId], references: [id], onDelete: Cascade)

  ansprechpartnerId String?
  ansprechpartner   Kontakt? @relation("ObjektAnsprechpartner", fields: [ansprechpartnerId], references: [id], onDelete: SetNull)

  einheiten                Einheit[]
  vorgaenge                Vorgang[]
  dokumente                Dokument[]
  zaehler                  Zaehler[]
  nebenkostenabrechnungen  Nebenkostenabrechnung[]
  belege                   Beleg[]

  @@index([mandantId])
}

model Einheit {
  id        String   @id @default(cuid())
  name      String
  kategorie String
  flaeche   Decimal? @db.Decimal(10, 2)
  kaltmiete Decimal? @db.Decimal(10, 2)
  zimmer    Decimal? @db.Decimal(3, 1)
  ausstattung Json   @default("[]")
  istSev    Boolean  @default(false)
  createdAt DateTime @default(now())

  objektId String
  objekt   Objekt @relation(fields: [objektId], references: [id], onDelete: Cascade)

  mietvertraege        Mietvertrag[]
  eigentuemerschaften  Eigentuemerschaft[]
  zaehler              Zaehler[]
  vorgaenge            Vorgang[]

  @@index([objektId])
}

// ── Kontakte ─────────────────────────────────────────────────────

enum KontaktTyp {
  MIETER
  EIGENTUEMER
  HAUSVERWALTUNG
  DIENSTLEISTER
  HAUSMEISTER
  SONSTIGE
}

model Kontakt {
  id         String     @id @default(cuid())
  typ        KontaktTyp
  typBezeichnung String?
  vorname    String?
  nachname   String?
  firma      String?
  email      String?
  telefon    String?
  debitorNr  String?
  kreditorNr String?
  geburtsdatum      DateTime?
  adresseStrasse    String?
  adresseHausnummer String?
  adressePlz        String?
  adresseOrt        String?
  notizen             String?
  bankKontoinhaber    String?
  bankName            String?
  bankIban            String?
  bankBic             String?
  bankGlaeubigerId    String?
  createdAt  DateTime   @default(now())

  mandantId String
  mandant   Mandant @relation(fields: [mandantId], references: [id], onDelete: Cascade)

  mietvertraege       Mietvertrag[]
  eigentuemerschaften Eigentuemerschaft[]
  vorgaenge           Vorgang[]
  dokumente           Dokument[]
  kommentare          Kommentar[]
  objekteAlsAnsprechpartner Objekt[] @relation("ObjektAnsprechpartner")

  @@index([mandantId])
}

// ── Mietverwaltung / WEG ─────────────────────────────────────────

enum MietvertragStatus {
  GEPLANT
  AKTIV
  BEENDET
}

model Mietvertrag {
  id                      String            @id @default(cuid())
  kaltmiete               Decimal           @db.Decimal(10, 2)
  nebenkostenVorauszahlung Decimal          @default(0) @db.Decimal(10, 2)
  kaution                 Decimal?          @db.Decimal(10, 2)
  iban                    String?
  sepaLastschrift         Boolean           @default(false)
  beginn                  DateTime
  ende                    DateTime?
  status                  MietvertragStatus @default(GEPLANT)
  createdAt               DateTime          @default(now())

  einheitId String
  einheit   Einheit @relation(fields: [einheitId], references: [id], onDelete: Cascade)

  mieterId String
  mieter   Kontakt @relation(fields: [mieterId], references: [id])

  dokumente Dokument[]
  forderungStatus ForderungStatus[]

  @@index([einheitId])
  @@index([mieterId])
}

/// WEG-Sondereigentum, spätere Phase — Datenmodell bereits vorbereitet
model Eigentuemerschaft {
  id             String   @id @default(cuid())
  hausgeldAnteil Decimal  @db.Decimal(10, 2)
  anteilProzent  Decimal? @db.Decimal(5, 2)
  seit           DateTime?
  createdAt      DateTime @default(now())

  einheitId String
  einheit   Einheit @relation(fields: [einheitId], references: [id], onDelete: Cascade)

  eigentuemerId String
  eigentuemer   Kontakt @relation(fields: [eigentuemerId], references: [id])

  @@index([einheitId])
  @@index([eigentuemerId])
}

// ── Vorgänge ───────────────────────────────────────────────────

enum VorgangStatus {
  OFFEN
  IN_BEARBEITUNG
  ABGESCHLOSSEN
}

model Vorgang {
  id          String        @id @default(cuid())
  nummer      Int           @default(autoincrement())
  titel       String
  beschreibung String?
  status      VorgangStatus @default(OFFEN)
  startDatum  DateTime?
  faelligkeit DateTime?
  createdAt   DateTime      @default(now())

  mandantId String
  mandant   Mandant @relation(fields: [mandantId], references: [id], onDelete: Cascade)

  objektId String?
  objekt   Objekt? @relation(fields: [objektId], references: [id])

  einheitId String?
  einheit   Einheit? @relation(fields: [einheitId], references: [id])

  verantwortlicherId String?
  verantwortlicher   User?   @relation("VorgangVerantwortlicher", fields: [verantwortlicherId], references: [id])

  kontaktId String?
  kontakt   Kontakt? @relation(fields: [kontaktId], references: [id])

  todos      ToDo[]
  kommentare Kommentar[]
  dokumente  Dokument[]
  labels     VorgangLabel[]
  verlauf    VorgangVerlauf[]

  @@index([mandantId])
  @@index([objektId])
}

model VorgangVerlauf {
  id        String   @id @default(cuid())
  text      String
  createdAt DateTime @default(now())

  vorgangId String
  vorgang   Vorgang @relation(fields: [vorgangId], references: [id], onDelete: Cascade)

  autorId String
  autor   User   @relation(fields: [autorId], references: [id])

  @@index([vorgangId])
}

model Label {
  id    String @id @default(cuid())
  name  String
  farbe String

  mandantId String
  mandant   Mandant @relation(fields: [mandantId], references: [id], onDelete: Cascade)

  vorgaenge VorgangLabel[]
  todos     ToDoLabel[]
  vorlagen  VorlageLabel[]

  @@index([mandantId])
}

model VorgangLabel {
  vorgangId String
  vorgang   Vorgang @relation(fields: [vorgangId], references: [id], onDelete: Cascade)

  labelId String
  label   Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([vorgangId, labelId])
}

model VorgangVorlage {
  id           String   @id @default(cuid())
  titel        String
  beschreibung String?
  createdAt    DateTime @default(now())

  mandantId String
  mandant   Mandant @relation(fields: [mandantId], references: [id], onDelete: Cascade)

  labels VorlageLabel[]

  @@index([mandantId])
}

model VorlageLabel {
  vorlageId String
  vorlage   VorgangVorlage @relation(fields: [vorlageId], references: [id], onDelete: Cascade)

  labelId String
  label   Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([vorlageId, labelId])
}

model ToDo {
  id          String    @id @default(cuid())
  titel       String
  icon        String?
  erledigt    Boolean   @default(false)
  faelligkeit DateTime?
  reihenfolge Int       @default(0)
  createdAt   DateTime  @default(now())

  vorgangId String
  vorgang   Vorgang @relation(fields: [vorgangId], references: [id], onDelete: Cascade)

  labels ToDoLabel[]

  @@index([vorgangId])
}

model ToDoLabel {
  todoId String
  todo   ToDo @relation(fields: [todoId], references: [id], onDelete: Cascade)

  labelId String
  label   Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([todoId, labelId])
}

model Kommentar {
  id        String   @id @default(cuid())
  text      String
  createdAt DateTime @default(now())

  vorgangId String?
  vorgang   Vorgang? @relation(fields: [vorgangId], references: [id], onDelete: Cascade)

  nebenkostenabrechnungId String?
  nebenkostenabrechnung   Nebenkostenabrechnung? @relation(fields: [nebenkostenabrechnungId], references: [id], onDelete: Cascade)

  kontaktId String?
  kontakt   Kontakt? @relation(fields: [kontaktId], references: [id])

  autorId String
  autor   User   @relation(fields: [autorId], references: [id])

  dokumente Dokument[]

  @@index([vorgangId])
  @@index([nebenkostenabrechnungId])
  @@index([kontaktId])
}

// ── Zähler ────────────────────────────────────────────────────

enum ZaehlerTyp {
  STROM
  GAS
  WASSER
  OEL
}

model Zaehler {
  id            String     @id @default(cuid())
  typ           ZaehlerTyp
  zaehlernummer String
  hauptzaehler  Boolean    @default(true)
  versorger     String?
  vertragsNr    String?
  lage          String?
  createdAt     DateTime   @default(now())

  mandantId String
  mandant   Mandant @relation(fields: [mandantId], references: [id], onDelete: Cascade)

  objektId String?
  objekt   Objekt? @relation(fields: [objektId], references: [id])

  einheitId String?
  einheit   Einheit? @relation(fields: [einheitId], references: [id])

  zaehlerstaende Zaehlerstand[]

  @@index([mandantId])
}

model Zaehlerstand {
  id        String   @id @default(cuid())
  datum     DateTime
  wert      Decimal  @db.Decimal(12, 3)
  createdAt DateTime @default(now())

  zaehlerId String
  zaehler   Zaehler @relation(fields: [zaehlerId], references: [id], onDelete: Cascade)

  @@index([zaehlerId])
}

// ── Dokumente ─────────────────────────────────────────────────

model DokumentKategorie {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  mandantId String
  mandant   Mandant @relation(fields: [mandantId], references: [id], onDelete: Cascade)

  dokumente Dokument[]
  belege    Beleg[]

  @@index([mandantId])
}

model Dokument {
  id         String   @id @default(cuid())
  dateiname  String
  speicherKey String  // Object-Storage Key/Pfad
  mimeType   String
  groesseBytes Int
  createdAt  DateTime @default(now())

  kategorieId String?
  kategorie   DokumentKategorie? @relation(fields: [kategorieId], references: [id], onDelete: SetNull)

  mandantId String
  mandant   Mandant @relation(fields: [mandantId], references: [id], onDelete: Cascade)

  hochgeladenVonId String
  hochgeladenVon   User   @relation(fields: [hochgeladenVonId], references: [id])

  objektId String?
  objekt   Objekt? @relation(fields: [objektId], references: [id])

  vorgangId String?
  vorgang   Vorgang? @relation(fields: [vorgangId], references: [id])

  mietvertragId String?
  mietvertrag   Mietvertrag? @relation(fields: [mietvertragId], references: [id])

  kommentarId String?
  kommentar   Kommentar? @relation(fields: [kommentarId], references: [id])

  kontaktId String?
  kontakt   Kontakt? @relation(fields: [kontaktId], references: [id])

  nebenkostenabrechnungId String?
  nebenkostenabrechnung   Nebenkostenabrechnung? @relation(fields: [nebenkostenabrechnungId], references: [id])

  @@index([mandantId])
}

// ── Nebenkostenabrechnung ────────────────────────────────────────

enum NebenkostenStatus {
  ENTWURF
  VERSENDET
}

enum VerteilerSchluessel {
  QM
  PERSONEN
  VERBRAUCH
  EINHEITEN
}

model Nebenkostenabrechnung {
  id           String            @id @default(cuid())
  zeitraumVon  DateTime
  zeitraumBis  DateTime
  status       NebenkostenStatus @default(ENTWURF)
  createdAt    DateTime          @default(now())

  objektId String
  objekt   Objekt @relation(fields: [objektId], references: [id], onDelete: Cascade)

  positionen NebenkostenPosition[]
  kommentare Kommentar[]
  dokumente  Dokument[]

  @@index([objektId])
}

model NebenkostenPosition {
  id             String              @id @default(cuid())
  bezeichnung    String
  betrag         Decimal             @db.Decimal(10, 2)
  verteilerschluessel VerteilerSchluessel

  nebenkostenabrechnungId String
  nebenkostenabrechnung   Nebenkostenabrechnung @relation(fields: [nebenkostenabrechnungId], references: [id], onDelete: Cascade)

  @@index([nebenkostenabrechnungId])
}

// ── Finanzen: Forderungen (Miete/Kaution) ────────────────────────
// Forderungen selbst (fällige Miete je Monat) werden nicht persistiert,
// sondern zur Anfragezeit aus den Mietverträgen berechnet (siehe
// ForderungenService). Hier wird nur der manuell gesetzte Status
// (bezahlt/verloren) je Mietvertrag+Zeitraum abgelegt.

enum ForderungTyp {
  MIETE
  KAUTION
}

enum ForderungStatusWert {
  BEZAHLT
  VERLOREN
}

model ForderungStatus {
  id        String              @id @default(cuid())
  typ       ForderungTyp
  periode   String // "YYYY-MM" für MIETE, "EINMALIG" für KAUTION
  status    ForderungStatusWert
  createdAt DateTime            @default(now())

  mietvertragId String
  mietvertrag   Mietvertrag @relation(fields: [mietvertragId], references: [id], onDelete: Cascade)

  @@unique([mietvertragId, typ, periode])
  @@index([mietvertragId])
}

// ── Finanzen: Belege (manuelle Ausgaben-/Einnahmenerfassung) ─────

enum BelegTyp {
  EINNAHME
  AUSGABE
}

enum BelegStatus {
  OFFEN
  BEZAHLT
}

model Beleg {
  id          String      @id @default(cuid())
  name        String
  belegnummer String?
  typ         BelegTyp    @default(AUSGABE)
  betrag      Decimal     @db.Decimal(10, 2)
  belegdatum  DateTime
  status      BelegStatus @default(OFFEN)
  notiz       String?
  createdAt   DateTime    @default(now())

  mandantId String
  mandant   Mandant @relation(fields: [mandantId], references: [id], onDelete: Cascade)

  objektId String?
  objekt   Objekt? @relation(fields: [objektId], references: [id], onDelete: SetNull)

  kategorieId String?
  kategorie   DokumentKategorie? @relation(fields: [kategorieId], references: [id], onDelete: SetNull)

  @@index([mandantId])
  @@index([objektId])
}
